{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentverden",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentverden-votes",
      "database_id": "fe415d04-f9d4-43fa-87cf-1a65506cbbdf"
    }
  ]
}
